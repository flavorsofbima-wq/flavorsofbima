# ============================================================
#  Environment variables — NOT used in Phase 1.
#  These are placeholders so you know what's coming in Phase 3
#  (online payments + database). Do NOT fill these in yet.
#
#  When the time comes:
#  1. Copy this file to ".env.local"
#  2. Paste your real keys there
#  3. NEVER commit ".env.local" to GitHub (it's already ignored)
# ============================================================

# --- Razorpay (Phase 3: online payments) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Database (Phase 3: saving orders) ---
# DATABASE_URL=

# --- Notifications (Phase 6) ---
# WHATSAPP_API_TOKEN=
